# ============================================================
# UNIVERSAL CRYPTO ARB — Environment Configuration
# Copy to .env and fill in values
# ============================================================

# --- Mode ---
# PAPER_MODE=True means all orders are simulated (default and safe)
# LIVE_MODE_ENABLED=True allows real order submission (DANGEROUS — requires API keys)
PAPER_MODE=True
LIVE_MODE_ENABLED=False

# --- Database ---
# Default: SQLite WAL mode in ./crypto_arb.db
DATABASE_URL=sqlite:///./crypto_arb.db
# Postgres production:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/crypto_arb

# --- Server ---
PORT=8900

# --- Risk Limits ---
MAX_GLOBAL_CAPITAL_USD=100000.0
MAX_EXCHANGE_CAPITAL_PCT=0.30
MAX_ASSET_EXPOSURE_PCT=0.20
MAX_DAILY_LOSS_USD=5000.0
MAX_SINGLE_TRADE_USD=10000.0
MAX_SLIPPAGE_PCT=0.10
MAX_DATA_AGE_SECONDS=30

# --- Scanning ---
OPPORTUNITY_SCAN_INTERVAL_MS=100
DISCOVERY_INTERVAL_SECONDS=3600

# --- Minimum Profit Gate ---
MIN_NET_PROFIT_USD=0.50
MIN_NET_PROFIT_PCT=0.05

# --- Exchange API Keys (only required when LIVE_MODE_ENABLED=True) ---
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Coinbase Advanced Trade
COINBASE_API_KEY=
COINBASE_API_SECRET=

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# OKX
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# --- Order Book ---
ORDER_BOOK_HOT_DEPTH=100
